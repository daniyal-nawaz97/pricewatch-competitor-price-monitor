# Copy to .env. Everything is optional.

# Public address of this app (used for "Open dashboard" links in emails and messages)
PUBLIC_BASE_URL=
# PORT=8003

# Email for the morning report and weekly summary (any SMTP: Gmail app password, Zoho, Brevo, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional chat alerts
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Collector etiquette
REQUEST_DELAY_SECONDS=1.5
USER_AGENT=PriceWatchBot/1.0 (+price monitoring)

# Landing page buttons (leave empty to open the demo)
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# Real client install: set DEMO_MODE=0 and an admin login (use a fresh data/ folder)
DEMO_MODE=1
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEMO_EMAIL=demo@pricewatch.app
DEMO_PASSWORD=demo1234
DEMO_HISTORY_DAYS=60
# Seconds to check one competitor page by hand (for "hours saved")
MANUAL_SECONDS_PER_CHECK=45
